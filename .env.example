# ═══════════════════════════════════════════════════════════════════════════
# OpenZync — Environment Variables (FULL RUNTIME CONFIG)
# ═══════════════════════════════════════════════════════════════════════════
#
# Every service reads this file directly (compose `env_file`, or
# `set -a && source .env && set +a` for host runs). There is no secrets
# manager, no sidecar, no bootstrap step: copy this file to `.env` and
# fill in every `<replace-...>` value.
#
# Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   openssl rand -base64 32
# ═══════════════════════════════════════════════════════════════════════════

# ── 1. Database (REQUIRED) ────────────────────────────────────────────────
# Asyncpg URL used by api, worker, and migrate. Use the migrator user for
# `make migrate` and the app user at runtime (or one URL for both in dev).
# Compose local-db: host is `postgres`; host runs: `localhost:5432`.
OZ_DATABASE_URL=<replace-with-asyncpg-url-e.g-postgresql+asyncpg://openzync:PASSWORD@postgres:5432/openzync>
DATABASE_URL=${OZ_DATABASE_URL}

# ── 2. Redis + FalkorDB (REQUIRED) ────────────────────────────────────────
# Compose DNS names; host runs use localhost:6379 / localhost:6380.
OZ_REDIS_URL=redis://redis:6379/0
# REQUIRED — the default graph backend is falkordb; the process fails fast
# at startup (like OZ_DATABASE_URL) when unset. No per-user override.
OZ_FALKORDB_URL=redis://falkordb:6379

# ── 2b. SurrealDB (OPTIONAL — alt graph backend only) ───────────────────────
# Unset (empty/absent) by default; the gate stays off while unset.
# Selecting graph_backend=surrealdb without OZ_SURREALDB_URL raises
# GraphBackendUnavailableError loudly (no fallback). Credentials default
# to root/root and namespace/database to openzync/openzync.
# OZ_SURREALDB_URL=ws://surrealdb:8000/rpc
# OZ_SURREALDB_USER=root
# OZ_SURREALDB_PASS=<replace-with-surrealdb-password>
# OZ_SURREALDB_NAMESPACE=openzync
# OZ_SURREALDB_DATABASE=openzync

# ── 3. Application secret key (REQUIRED) ──────────────────────────────────
# Used for JWT signing and other cryptographic operations. Never logged.
#
# Generate a 48+ char URL-safe secret:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
OZ_SECRET_KEY=<replace-with-48+-char-url-safe-secret>

# ── 4. Webhook signing secret (REMOVED — deprecated) ───────────────────────
# The global OZ_WEBHOOK_SIGNING_SECRET is removed. Webhook signing secrets
# are now per-endpoint via core/crypto (see migration
# 20260806_per_org_webhook_signing_secret). Do NOT set a global secret —
# any OZ_WEBHOOK_SIGNING_SECRET value in the environment is ignored.
# OZ_WEBHOOK_SIGNING_SECRET=<removed — per-endpoint secrets only>

# ── 5. Postgres superuser password (REQUIRED on first boot, local-db) ────
# Only used by postgres-init to create the openzync database and the
# migrator/app roles. After first boot it is the superuser password stored
# in postgres-data.
#
# Generate a 32-byte base64 password:
#   openssl rand -base64 32
POSTGRES_PASSWORD=<replace-with-32-byte-base64>

# ── 6. Optional tuning (defaults shown) ───────────────────────────────────
OZ_ENVIRONMENT=development
OZ_LOG_LEVEL=INFO
OZ_CORS_ORIGINS=http://localhost:3000
OZ_HOSTS_ALLOWED=localhost:8000
OZ_MAX_WORKERS=4
OZ_JWT_ACCESS_TOKEN_TTL_MINUTES=30
OZ_JWT_REFRESH_TOKEN_TTL_DAYS=7
OZ_RATE_LIMIT_IP_MAX=10
OZ_RATE_LIMIT_WINDOW_SEC=60
OZ_DB_POOL_SIZE=4
OZ_DB_MAX_OVERFLOW=1
OZ_TRUSTED_PROXY_IPS=172.28.0.0/24
OZ_SMTP_HOST=localhost
OZ_SMTP_PORT=1025
OZ_SMTP_USERNAME=
OZ_SMTP_PASSWORD=
OZ_SMTP_FROM_ADDR=no-reply@openzync.local
OZ_SMTP_USE_TLS=false
OZ_SMTP_START_TLS=false

# ── 7. Blob storage — S3-compatible (MinIO in dev) ─────────────────────────
# Dev values below match scripts/dev_preflight.sh up (host-local MinIO).
# In prod set these via the compose env_file / deployment environment.
MINIO_ROOT_USER=openzync
MINIO_ROOT_PASSWORD=<replace-with-minio-root-password> # prod: set via env, not committed
OZ_S3_ENDPOINT_URL=http://localhost:9000
OZ_S3_REGION=auto
OZ_S3_ACCESS_KEY_ID=openzync
OZ_S3_SECRET_ACCESS_KEY=<replace-with-minio-root-password>
OZ_S3_BUCKET_NAME=openzync-blobs
OZ_S3_BACKEND=s3
OZ_BLOB_MAX_SIZE_MB=50
OZ_BLOB_IMAGE_EXTRACTION=none
